{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "swift: build (debug)",
      "type": "shell",
      "command": "swift build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "swift: run",
      "type": "shell",
      "command": "swift run",
      "group": "none",
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "package: build .app bundle",
      "type": "shell",
      "command": "./build-app.sh",
      "group": "none",
      "problemMatcher": []
    }
  ]
}
